# ==========================================
# Variables de Entorno - SegurAPI Backend
# ==========================================

# Base de Datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/seguros_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Configuración de Seguridad JWT
JWT_SECRET=SegurApiClaveSecretaDeDesarrolloConMasDe32BytesDeLongitud2026!
JWT_EXPIRATION=86400000

# Configuración de CORS (orígenes permitidos separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seeder de datos iniciales (true en desarrollo, false en producción)
SEEDER_ENABLED=true

# Servicio de Correo Electrónico (Gmail SMTP)
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion_gmail

# Integración MercadoPago
MP_ACCESS_TOKEN=TEST-tu-access-token-aqui

# Inteligencia Artificial (Google Gemini Flash)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
